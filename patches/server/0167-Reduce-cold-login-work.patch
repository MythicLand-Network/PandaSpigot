+    @Test
+    public void loginCompletesTheWatchedCenterWithoutProbingDiskAgain() throws Exception {
+        WorldServer world = allocate(WorldServer.class);
+        List<String> events = new ArrayList<>();
+        ChunkRegionLoader loader = new ChunkRegionLoader(this.temporary.newFolder()) {
+            @Override
+            public boolean chunkExists(World ignored, int x, int z) {
+                throw new AssertionError("A pending view load already owns the disk lookup");
+            }
+        };
+        ChunkProviderServer provider = new ChunkProviderServer(world, loader, null) {
+            @Override
+            public Chunk originalGetChunkAt(int x, int z) {
+                events.add("generate");
+                Chunk chunk = new EmptyChunk(world, x, z);
+                this.chunks.put(LongHash.toLong(x, z), chunk);
+                return chunk;
+            }
+        };
+        provider.loadPlayerChunk(-1, 0, () -> events.add("notify"));
+        provider.completePlayerChunk(-1, 0);
+        assertNotNull(provider.getChunkIfLoaded(-1, 0));
+        provider.completePlayerChunk(-1, 0);
+        assertEquals(Arrays.asList("generate", "notify"), events);
