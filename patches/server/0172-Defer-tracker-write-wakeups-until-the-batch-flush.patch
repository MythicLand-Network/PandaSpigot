@@ -115,6 +119,60 @@ public class NetworkFlushTest extends AbstractTestingBase {
         }
     }
 
+    @Test
+    public void onlyTrackerWritesMayWaitForTheClosingFlush() throws Exception {
+        Field config = PandaSpigotConfig.class.getDeclaredField("config");
+        config.setAccessible(true);
+        Object previous = config.get(null);
+        RecordingEventLoop loop = new RecordingEventLoop();
+        LocalChannel channel = new LocalChannel();
+        List<Object> writes = new ArrayList<>();
+        try {
+            config.set(null, new PandaSpigotConfig());
+            loop.register(channel).sync();
+            channel.pipeline().addLast(new ChannelOutboundHandlerAdapter() {
+                @Override
+                public void write(ChannelHandlerContext ctx, Object message, ChannelPromise promise) {
+                    writes.add(message);
+                    promise.setSuccess();
+                }
+            });
+            NetworkManager network = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            network.channel = channel;
+            channel.attr(NetworkManager.c).set(EnumProtocol.PLAY);
+            Packet first = new PacketPlayOutEntityVelocity(1, 0, 0, 0);
+            Packet concurrent = new PacketPlayOutEntityVelocity(2, 0, 0, 0);
+            Packet urgent = new PacketPlayOutKeepAlive(1);
+            Packet last = new PacketPlayOutEntityVelocity(3, 0, 0, 0);
+            network.disableAutomaticFlush();
+            network.handle(first);
+            Thread sender = new Thread(() -> network.handle(concurrent));
+            sender.start();
+            sender.join();
+            network.handle(urgent);
+            network.handle(last);
+            network.enableAutomaticFlush();
+
+            loop.submit(() -> {}).sync();
+            assertEquals(2, loop.lazyWrites.get());
+            assertEquals(Arrays.asList(first, concurrent, urgent, last), writes);
+        } finally {
+            channel.close().sync();
+            loop.shutdownGracefully(0, 0, java.util.concurrent.TimeUnit.MILLISECONDS).sync();
+            config.set(null, previous);
+        }
+    }
+
+    private static class RecordingEventLoop extends DefaultEventLoop {
+        private final AtomicInteger lazyWrites = new AtomicInteger();
+
+        @Override
+        public void lazyExecute(Runnable task) {
+            lazyWrites.incrementAndGet();
+            super.lazyExecute(task);
+        }
+    }
+
     private static class CountingFlush extends ChannelOutboundHandlerAdapter {
