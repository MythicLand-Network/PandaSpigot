+    @Test
+    public void missingViewChunksGenerateWithinTheCompletionBudget() throws Exception {
+        Field configField = PandaSpigotConfig.class.getDeclaredField("config");
+        configField.setAccessible(true);
+        Object previous = configField.get(null);
+        PandaSpigotConfig config = new PandaSpigotConfig();
+        config.chunkIoMaxChunksPerTick = 1;
+        configField.set(null, config);
+        try {
+            WorldServer world = allocate(WorldServer.class);
+            java.io.File folder = this.temporary.newFolder();
+            List<Integer> generated = new ArrayList<>();
+            Thread mainThread = Thread.currentThread();
+            ChunkProviderServer provider = new ChunkProviderServer(world, new ChunkRegionLoader(folder), null) {
+                @Override
+                public Chunk originalGetChunkAt(int x, int z) {
+                    assertSame(mainThread, Thread.currentThread());
+                    generated.add(x);
+                    Chunk chunk = new EmptyChunk(world, x, z);
+                    this.chunks.put(LongHash.toLong(x, z), chunk);
+                    return chunk;
+                }
+            };
+            List<Integer> ready = new ArrayList<>();
+            provider.loadPlayerChunk(0, 0, () -> ready.add(0));
+            Runnable canceled = () -> fail("Removed viewer still received a chunk");
+            provider.loadPlayerChunk(1, 0, canceled);
+            ChunkIOExecutor.dropQueuedChunkLoad(world, 1, 0, canceled);
+            provider.loadPlayerChunk(2, 0, () -> ready.add(2));
+            assertTrue(generated.isEmpty());
+
+            long deadline = System.nanoTime() + 5_000_000_000L;
+            while (ready.size() < 2 && System.nanoTime() < deadline) {
+                int before = generated.size();
+                ChunkIOExecutor.tick();
+                assertTrue(generated.size() <= before + 1);
+                if (generated.size() == before) Thread.sleep(1);
+            }
+            assertEquals(2, generated.size());
+            assertTrue(generated.containsAll(Arrays.asList(0, 2)));
+            assertEquals(generated, ready);
+            assertFalse(new java.io.File(folder, "region").exists());
+        } finally {
+            configField.set(null, previous);
+        }
+    }
