+            queue.startOuterPacing(first);
+            queue.startOuterPacing(first);
+            queue.startOuterPacing(second);
+            assertEquals(4, PlayerChunkSendQueue.outerChunkLimit(config, first, 102));
+            assertEquals(0, PlayerChunkSendQueue.outerChunkLimit(config, second, 102));
+            assertEquals(0, PlayerChunkSendQueue.outerChunkLimit(config, first, 103));
+            assertEquals(4, PlayerChunkSendQueue.outerChunkLimit(config, second, 103));
+            assertEquals(Integer.MAX_VALUE, PlayerChunkSendQueue.outerChunkLimit(config, first, 200));
+            assertEquals(Integer.MAX_VALUE, PlayerChunkSendQueue.outerChunkLimit(config, first, 201));
+        } finally {
+            configField.set(null, previousConfig);
+            MinecraftServer.currentTick = previousTick;
         }
     }

