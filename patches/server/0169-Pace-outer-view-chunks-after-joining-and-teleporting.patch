 import java.util.ArrayList;
 import java.util.LinkedHashMap;
+import java.util.List;
 import java.util.Map;
 import java.util.UUID;

 public final class PlayerChunkSendQueue {
+    private static final int OUTER_SEND_INTERVAL_TICKS = 3;
+    private static final int MAX_OUTER_CHUNKS_PER_BATCH = 4;
+    private static final int MAX_OUTER_CHUNKS_PER_TICK = 10;
+    private static final int OUTER_PACING_TICKS = 100;
+
     private final Map<UUID, EntityPlayer> pending = new LinkedHashMap<>();
+    private int nextOuterSendPhase;

     public void add(EntityPlayer player) {
         this.pending.put(player.getUniqueID(), player);
     }

+    public void startOuterPacing(EntityPlayer player) {
+        if (!PandaSpigotConfig.get().paceOuterChunksAfterTeleport) return;
+        int pacingUntilTick = MinecraftServer.currentTick + OUTER_PACING_TICKS;
+        if (player.outerChunkPacingUntilTick == pacingUntilTick) return;
+        player.outerChunkPacingUntilTick = pacingUntilTick;
+        player.outerChunkSendPhase = this.nextOuterSendPhase;
+        this.nextOuterSendPhase = (this.nextOuterSendPhase + 1) % OUTER_SEND_INTERVAL_TICKS;
+    }
+
     public void tick(MinecraftServer server) {
         PandaSpigotConfig config = PandaSpigotConfig.get();
+        int outerChunksRemaining = MAX_OUTER_CHUNKS_PER_TICK;
+        List<EntityPlayer> playersWithOuterSends = new ArrayList<>();
         for (EntityPlayer player : new ArrayList<>(this.pending.values())) {
             this.pending.remove(player.getUniqueID());
             if (server.getPlayerList().a(player.getUniqueID()) != player || player.playerConnection == null
                 || !player.playerConnection.networkManager.g() || player.chunkCoordIntPairQueue.isEmpty()) continue;
             if (player.playerConnection.networkManager.canSendChunks(config.chunkSendMaxPendingBytes)) {
-                player.sendQueuedChunks();
+                int maxOuterChunks = outerChunkLimit(config, player, MinecraftServer.currentTick);
+                if (maxOuterChunks == Integer.MAX_VALUE) {
+                    player.sendQueuedChunks(maxOuterChunks);
+                } else {
+                    int sentCount = player.sendQueuedChunks(Math.min(maxOuterChunks, outerChunksRemaining));
+                    if (sentCount > 0) {
+                        outerChunksRemaining -= sentCount;
+                        player.outerChunkPacingUntilTick = MinecraftServer.currentTick + OUTER_PACING_TICKS;
+                        playersWithOuterSends.add(player);
+                    }
+                }
             }
             if (!player.chunkCoordIntPairQueue.isEmpty()) this.pending.put(player.getUniqueID(), player);
         }
+        for (EntityPlayer player : playersWithOuterSends) {
+            if (this.pending.remove(player.getUniqueID()) != null) this.add(player);
+        }
+    }
+
+    static int outerChunkLimit(PandaSpigotConfig config, EntityPlayer player, int tick) {
+        if (!config.paceOuterChunksAfterTeleport || player.outerChunkSendPhase < 0) return Integer.MAX_VALUE;
+        if (player.outerChunkPacingUntilTick - tick <= 0) {
+            player.outerChunkSendPhase = -1;
+            return Integer.MAX_VALUE;
+        }
+        return Math.floorMod(tick, OUTER_SEND_INTERVAL_TICKS) == player.outerChunkSendPhase
+                ? MAX_OUTER_CHUNKS_PER_BATCH : 0;
     }
 }
