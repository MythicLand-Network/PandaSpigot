diff --git a/src/test/java/net/minecraft/server/WorldEntityCollisionTest.java b/src/test/java/net/minecraft/server/WorldEntityCollisionTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/net/minecraft/server/WorldEntityCollisionTest.java
@@ -0,0 +1,157 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Iterator;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class WorldEntityCollisionTest extends AbstractTestingBase {
+    private static int nextEntityId;
+    @Test
+    public void filteringPreservesPlayerBoatAndMinecartCollisionBoxes() throws Exception {
+        EntityPlayer player = player(WorldSettings.EnumGamemode.SURVIVAL);
+        EntityPlayer spectator = player(WorldSettings.EnumGamemode.SPECTATOR);
+        EntityBoat boat = allocate(EntityBoat.class);
+        EntityMinecartRideable minecart = allocate(EntityMinecartRideable.class);
+        HardBoxEntity custom = allocate(HardBoxEntity.class);
+        boat.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        minecart.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        custom.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        List<Entity> candidates = Arrays.asList(player, spectator, boat, minecart, custom);
+        for (Entity moving : candidates) {
+            List<AxisAlignedBB> original = new ArrayList<>();
+            List<AxisAlignedBB> filtered = new ArrayList<>();
+            for (Entity candidate : candidates) {
+                if (candidate == moving) continue;
+                if (IEntitySelector.d.apply(candidate)) appendBoxes(moving, candidate, original);
+                if (World.collisionSelector(moving).apply(candidate)) appendBoxes(moving, candidate, filtered);
+            }
+            assertEquals("Filtering must preserve every hard collision box for " + moving.getClass(), original, filtered);
+        }
+        assertFalse(World.hasCollisionBox(player, player));
+        assertFalse(World.hasCollisionBox(boat, spectator));
+        assertTrue(World.hasCollisionBox(player, boat));
+        assertTrue(World.hasCollisionBox(minecart, player));
+        player.collidesWithEntities = false;
+        assertFalse(World.hasCollisionBox(minecart, player));
+    }
+
+    @Test
+    public void hardCollisionCountsFollowMembershipAndLeaveNormalQueriesIntact() throws Exception {
+        Chunk chunk = new Chunk(null, 0, 0);
+        CountingSlice slice = new CountingSlice();
+        chunk.entitySlices[0] = slice;
+        EntityPlayer player = player(WorldSettings.EnumGamemode.SURVIVAL);
+        chunk.a(player);
+        AxisAlignedBB area = new AxisAlignedBB(-1, -1, -1, 2, 2, 2);
+        List<Entity> found = new ArrayList<>();
+        Entity excluded = null;
+        chunk.a(excluded, area, found, World.HARD_COLLISIONS);
+        assertTrue(found.isEmpty());
+        assertEquals("A player-only chunk needs no hard collision scan", 0, slice.iterations);
+        chunk.a(excluded, area, found, IEntitySelector.d);
+        assertEquals(Arrays.asList(player), found);
+
+        EntityBoat boat = allocate(EntityBoat.class);
+        boat.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        chunk.a(boat);
+        found.clear();
+        chunk.a(excluded, area, found, World.HARD_COLLISIONS);
+        assertEquals(Arrays.asList(boat), found);
+        chunk.b(boat);
+        chunk.b(boat);
+        slice.iterations = 0;
+        found.clear();
+        chunk.a(excluded, area, found, World.HARD_COLLISIONS);
+        assertTrue(found.isEmpty());
+        assertEquals("Removing the last hard collider restores the empty-chunk shortcut", 0, slice.iterations);
+
+        HardBoxEntity custom = allocate(HardBoxEntity.class);
+        custom.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        chunk.a(custom);
+        chunk.a(excluded, area, found, World.HARD_COLLISIONS);
+        assertEquals(Arrays.asList(custom), found);
+        chunk.b(custom);
+        found.clear();
+
+        MultipartEntity parent = allocate(MultipartEntity.class);
+        parent.parts = new Entity[]{boat};
+        parent.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        chunk.a(parent);
+        chunk.a(excluded, area, found, World.HARD_COLLISIONS);
+        assertEquals("Custom multipart bodies keep their child collision boxes", Arrays.asList(boat), found);
+        chunk.b(parent);
+    }
+
+    private static final class CountingSlice extends ArrayList<Entity> {
+        private int iterations;
+
+        @Override
+        public Iterator<Entity> iterator() {
+            ++this.iterations;
+            return super.iterator();
+        }
+    }
+
+    private static final class MultipartEntity extends EntityArmorStand {
+        private Entity[] parts;
+
+        private MultipartEntity() {
+            super((World) null);
+        }
+
+        @Override
+        public Entity[] aB() {
+            return this.parts;
+        }
+    }
+
+    private static final class HardBoxEntity extends EntityArmorStand {
+        private HardBoxEntity() {
+            super((World) null);
+        }
+
+        @Override
+        public AxisAlignedBB S() {
+            return this.getBoundingBox();
+        }
+    }
+
+    private static void appendBoxes(Entity moving, Entity candidate, List<AxisAlignedBB> boxes) {
+        AxisAlignedBB box = candidate.S();
+        if (box != null) boxes.add(box);
+        box = moving.j(candidate);
+        if (box != null) boxes.add(box);
+    }
+
+    private static EntityPlayer player(WorldSettings.EnumGamemode mode) throws Exception {
+        EntityPlayer player = allocate(EntityPlayer.class);
+        player.collidesWithEntities = true;
+        player.a(new AxisAlignedBB(0, 0, 0, 1, 1, 1));
+        Field manager = EntityPlayer.class.getField("playerInteractManager");
+        manager.setAccessible(true);
+        manager.set(player, new PlayerInteractManager(null));
+        Field field = PlayerInteractManager.class.getDeclaredField("gamemode");
+        field.setAccessible(true);
+        field.set(player.playerInteractManager, mode);
+        return player;
+    }
+
+    private static <T> T allocate(Class<T> type) throws Exception {
+        Class<?> unsafe = Class.forName("sun.misc.Unsafe");
+        Field field = unsafe.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        T instance = type.cast(unsafe.getMethod("allocateInstance", Class.class).invoke(field.get(null), type));
+        if (instance instanceof Entity) {
+            Field id = Entity.class.getDeclaredField("id");
+            id.setAccessible(true);
+            id.setInt(instance, ++nextEntityId);
+        }
+        return instance;
+    }
+}
