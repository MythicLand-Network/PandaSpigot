+    // PandaSpigot start
+    static final Predicate<Entity> HARD_COLLISIONS = candidate -> IEntitySelector.d.apply(candidate) && candidate.S() != null;
+    private static final ClassValue<CollisionMethods> COLLISION_METHODS = new ClassValue<CollisionMethods>() {
+        @Override
+        protected CollisionMethods computeValue(Class<?> type) {
+            try {
+                Class<?> boxOwner = type.getMethod("S").getDeclaringClass();
+                boolean entityBox = boxOwner != Entity.class && boxOwner != EntityMinecartAbstract.class;
+                boolean specificBox = type.getMethod("j", Entity.class).getDeclaringClass() != Entity.class;
+                boolean multipart = type.getMethod("aB").getDeclaringClass() != Entity.class;
+                return new CollisionMethods(entityBox, specificBox, multipart);
+            } catch (NoSuchMethodException failure) {
+                throw new IllegalStateException("Cannot inspect collision methods for " + type.getName(), failure);
+            }
+        }
+    };
+
+    static Predicate<Entity> collisionSelector(Entity moving) {
+        if (!COLLISION_METHODS.get(moving.getClass()).specificBox) return HARD_COLLISIONS;
+        return candidate -> hasCollisionBox(moving, candidate);
+    }
+
+    static boolean canProvideHardCollisionBox(Entity entity) {
+        CollisionMethods methods = COLLISION_METHODS.get(entity.getClass());
+        return methods.entityBox || methods.multipart;
+    }
+
+    static boolean hasCollisionBox(Entity moving, Entity candidate) {
+        return IEntitySelector.d.apply(candidate) && (candidate.S() != null || moving.j(candidate) != null);
+    }
+
+    private static final class CollisionMethods {
+        private final boolean entityBox;
+        private final boolean specificBox;
+        private final boolean multipart;
+
+        private CollisionMethods(boolean entityBox, boolean specificBox, boolean multipart) {
+            this.entityBox = entityBox;
+            this.specificBox = specificBox;
+            this.multipart = multipart;
+        }
+    }
+    // PandaSpigot end
 
