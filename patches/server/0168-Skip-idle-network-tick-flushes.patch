+package net.minecraft.server;
+
+import com.hpfxd.pandaspigot.config.PandaSpigotConfig;
+import io.netty.channel.ChannelHandlerContext;
+import io.netty.channel.ChannelOutboundHandlerAdapter;
+import io.netty.channel.ChannelPromise;
+import io.netty.channel.DefaultEventLoop;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.channel.local.LocalChannel;
+import java.lang.reflect.Field;
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.Test;
+
+import static org.junit.Assert.*;
+
+public class NetworkFlushTest extends AbstractTestingBase {
+    @Test
+    public void idleTicksDoNotScheduleTasksButQueuedPluginWritesStillFlush() throws Exception {
+        DefaultEventLoop loop = new DefaultEventLoop();
+        LocalChannel channel = new LocalChannel();
+        CountingFlush counter = new CountingFlush() {
+            @Override
+            public void write(ChannelHandlerContext ctx, Object message, ChannelPromise promise) {
+                promise.setSuccess();
+            }
+        };
+        NetworkFlushHandler handler = new NetworkFlushHandler();
+        try {
+            loop.register(channel).sync();
+            channel.pipeline().addLast(counter, handler);
+            loop.submit(() -> {
+                handler.flushIfNeeded(channel);
+                assertEquals("Idle tick must not enqueue a flush task", 0, loop.pendingTasks());
+                loop.execute(() -> channel.write("queued-plugin-write"));
+                handler.flushIfNeeded(channel);
+            }).sync();
+            loop.submit(() -> assertEquals(1, counter.flushes)).sync();
+        } finally {
+            channel.close().sync();
+            loop.shutdownGracefully(0, 0, java.util.concurrent.TimeUnit.MILLISECONDS).sync();
+        }
+    }
+
+    @Test
+    public void idleAndAlreadyFlushedWritesDoNotFlushAgain() {
+        CountingFlush counter = new CountingFlush();
+        NetworkFlushHandler handler = new NetworkFlushHandler();
+        EmbeddedChannel channel = new EmbeddedChannel(counter, handler);
+        try {
+            for (int tick = 0; tick < 20; tick++) handler.flushIfNeeded(channel);
+            channel.runPendingTasks();
+            assertEquals(0, counter.flushes);
+            channel.writeAndFlush("immediate");
+            handler.flushIfNeeded(channel);
+            channel.runPendingTasks();
+            assertEquals(1, counter.flushes);
+            assertEquals("immediate", channel.readOutbound());
+            channel.write("direct-plugin-write");
+            handler.flushIfNeeded(channel);
+            channel.runPendingTasks();
+            assertEquals(2, counter.flushes);
+            assertEquals("direct-plugin-write", channel.readOutbound());
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    public void queuedWritesAreFlushedInOrderDuringTheSameEventLoopTurn() {
+        CountingFlush counter = new CountingFlush();
+        NetworkFlushHandler handler = new NetworkFlushHandler();
+        EmbeddedChannel channel = new EmbeddedChannel(counter, handler);
+        try {
+            channel.eventLoop().execute(() -> channel.write("spawn"));
+            channel.eventLoop().execute(() -> channel.write("equipment"));
+            handler.flushIfNeeded(channel);
+            channel.runPendingTasks();
+            assertEquals(1, counter.flushes);
+            assertEquals("spawn", channel.readOutbound());
+            assertEquals("equipment", channel.readOutbound());
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+    }
+
+    @Test
+    public void trackerBatchAndUrgentPacketsKeepTheirFlushBoundaries() throws Exception {
+        Field config = PandaSpigotConfig.class.getDeclaredField("config");
+        config.setAccessible(true);
+        Object previous = config.get(null);
+        CountingFlush counter = new CountingFlush();
+        EmbeddedChannel channel = null;
+        try {
+            config.set(null, new PandaSpigotConfig());
+            NetworkManager network = new NetworkManager(EnumProtocolDirection.SERVERBOUND);
+            channel = new EmbeddedChannel(counter, network);
+            channel.attr(NetworkManager.c).set(EnumProtocol.PLAY);
+            PacketPlayOutEntityVelocity movement = new PacketPlayOutEntityVelocity(42, 0.1, 0.2, 0.3);
+            network.disableAutomaticFlush();
+            network.handle(movement);
+            assertEquals(0, counter.flushes);
+            network.enableAutomaticFlush();
+            assertEquals(1, counter.flushes);
+            assertSame(movement, channel.readOutbound());
+            network.disableAutomaticFlush();
+            network.handle(new PacketPlayOutKeepAlive(7));
+            assertEquals(2, counter.flushes);
+            assertTrue(channel.readOutbound() instanceof PacketPlayOutKeepAlive);
+            network.handle(new PacketPlayOutKickDisconnect(new ChatComponentText("done")));
+            assertEquals(3, counter.flushes);
+            assertTrue(channel.readOutbound() instanceof PacketPlayOutKickDisconnect);
+        } finally {
+            if (channel != null) channel.finishAndReleaseAll();
+            config.set(null, previous);
+        }
+    }
+
+    private static class CountingFlush extends ChannelOutboundHandlerAdapter {
+        int flushes;
+
+        @Override
+        public void flush(ChannelHandlerContext ctx) {
+            this.flushes++;
+            ctx.flush();
+        }
+    }
+}
