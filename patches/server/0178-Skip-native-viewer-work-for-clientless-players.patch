diff --git a/src/test/java/net/minecraft/server/ClientlessEntityTrackerTest.java b/src/test/java/net/minecraft/server/ClientlessEntityTrackerTest.java
new file mode 100644
--- /dev/null
+++ b/src/test/java/net/minecraft/server/ClientlessEntityTrackerTest.java
@@ -0,0 +1,194 @@
+package net.minecraft.server;
+
+import java.lang.reflect.Field;
+import java.util.Iterator;
+import java.util.LinkedHashSet;
+
+import org.bukkit.support.AbstractTestingBase;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.spigotmc.AsyncCatcher;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+public class ClientlessEntityTrackerTest extends AbstractTestingBase {
+    private boolean asyncCatcherEnabled;
+
+    @Before
+    public void disableAsyncCatcher() {
+        this.asyncCatcherEnabled = AsyncCatcher.enabled;
+        AsyncCatcher.enabled = false;
+    }
+
+    @After
+    public void restoreAsyncCatcher() {
+        AsyncCatcher.enabled = this.asyncCatcherEnabled;
+    }
+
+    @Test
+    public void clientlessRespawnDoesNotScanWorldViewers() throws Exception {
+        CountingEntries entries = new CountingEntries();
+        for (int index = 0; index < 1000; index++) {
+            entries.add(allocate(CountingEntry.class));
+        }
+        EntityTracker tracker = tracker(entries);
+        TestPlayer player = allocate(TestPlayer.class);
+        player.clientless = true;
+        for (int repetition = 0; repetition < 3; repetition++) {
+            entries.visits = 0;
+            tracker.untrackEntity(player);
+            System.out.println("clientless untrack entries visited: " + entries.visits);
+        }
+        assertEquals(0, entries.visits);
+    }
+
+    @Test
+    public void ordinaryUntrackedPlayerStillLeavesOtherViewerSets() throws Exception {
+        CountingEntries entries = new CountingEntries();
+        CountingEntry entry = allocate(CountingEntry.class);
+        entries.add(entry);
+
+        tracker(entries).untrackEntity(allocate(TestPlayer.class));
+
+        assertEquals(1, entries.visits);
+        assertEquals(1, entry.viewerRemovals);
+    }
+
+    @Test
+    public void clientlessPlayerOwnTrackedEntityStillGetsRemoved() throws Exception {
+        CountingEntries entries = new CountingEntries();
+        CountingEntry entry = allocate(CountingEntry.class);
+        entries.add(entry);
+        EntityTracker tracker = tracker(entries);
+        TestPlayer player = allocate(TestPlayer.class);
+        player.clientless = true;
+        tracker.trackedEntities.a(player.getId(), entry);
+
+        tracker.untrackEntity(player);
+
+        assertEquals(0, entries.visits);
+        assertEquals(0, entry.viewerRemovals);
+        assertEquals(1, entry.entityRemovals);
+        assertEquals(0, entries.size());
+        assertNull(tracker.trackedEntities.get(player.getId()));
+    }
+
+    @Test
+    public void clientlessTrackingStillRegistersItsOwnEntity() throws Exception {
+        CountingEntries entries = new CountingEntries();
+        entries.add(allocate(CountingEntry.class));
+        RegistrationTracker tracker = allocate(RegistrationTracker.class);
+        Field field = EntityTracker.class.getDeclaredField("c");
+        field.setAccessible(true);
+        field.set(tracker, entries);
+        TestPlayer player = allocate(TestPlayer.class);
+        player.clientless = true;
+
+        tracker.track(player);
+
+        assertEquals(1, tracker.registrations);
+        assertEquals(0, entries.visits);
+    }
+
+    @Test
+    public void clientlessPlayerCannotBecomeNativeViewer() throws Exception {
+        TestPlayer player = allocate(TestPlayer.class);
+        player.clientless = true;
+        allocate(EntityTrackerEntry.class).updatePlayer(player);
+    }
+
+    private static EntityTracker tracker(CountingEntries entries) throws Exception {
+        EntityTracker tracker = allocate(EntityTracker.class);
+        Field field = EntityTracker.class.getDeclaredField("c");
+        field.setAccessible(true);
+        field.set(tracker, entries);
+        tracker.trackedEntities = new IntHashMap<EntityTrackerEntry>();
+        return tracker;
+    }
+
+    private static <T> T allocate(Class<T> type) throws Exception {
+        Class<?> unsafe = Class.forName("sun.misc.Unsafe");
+        Field field = unsafe.getDeclaredField("theUnsafe");
+        field.setAccessible(true);
+        return type.cast(unsafe.getMethod("allocateInstance", Class.class).invoke(field.get(null), type));
+    }
+
+    private static class TestPlayer extends EntityPlayer {
+        private boolean clientless;
+
+        private TestPlayer() {
+            super(null, null, null, null);
+        }
+
+        public boolean isClientlessPlayer() {
+            return this.clientless;
+        }
+    }
+
+    private static class RegistrationTracker extends EntityTracker {
+        private int registrations;
+
+        private RegistrationTracker() {
+            super(null);
+        }
+
+        @Override
+        public void addEntity(Entity entity, int range, int interval) {
+            this.registrations++;
+        }
+    }
+
+    private static class CountingEntry extends EntityTrackerEntry {
+        private int viewerRemovals;
+        private int entityRemovals;
+
+        private CountingEntry() {
+            super(null, 0, 0, false);
+        }
+
+        @Override
+        public void a(EntityPlayer player) {
+            this.viewerRemovals++;
+        }
+
+        @Override
+        public void a() {
+            this.entityRemovals++;
+        }
+
+        @Override
+        public int hashCode() {
+            return System.identityHashCode(this);
+        }
+
+        @Override
+        public boolean equals(Object other) {
+            return this == other;
+        }
+    }
+
+    private static class CountingEntries extends LinkedHashSet<EntityTrackerEntry> {
+        private int visits;
+
+        @Override
+        public Iterator<EntityTrackerEntry> iterator() {
+            final Iterator<EntityTrackerEntry> delegate = super.iterator();
+            return new Iterator<EntityTrackerEntry>() {
+                public boolean hasNext() {
+                    return delegate.hasNext();
+                }
+
+                public EntityTrackerEntry next() {
+                    visits++;
+                    return delegate.next();
+                }
+
+                public void remove() {
+                    delegate.remove();
+                }
+            };
+        }
+    }
+}
