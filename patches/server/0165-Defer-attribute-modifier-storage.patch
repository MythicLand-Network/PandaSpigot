+package net.minecraft.server;
+
+import java.util.Collection;
+import java.util.UUID;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class AttributeModifiableTest {
+    @Test
+    public void inheritedModifiersAndLiveOperationViewsSurviveLazyInitialization() {
+        AttributeMapServer attributes = new AttributeMapServer();
+        IAttribute parent = new AttributeRanged(null, "parent", 1, 0, 100);
+        IAttribute child = new AttributeRanged(parent, "child", 10, 0, 100);
+        AttributeInstance base = attributes.b(parent);
+        AttributeInstance value = attributes.b(child);
+        Collection<AttributeModifier> additions = value.a(0);
+        AttributeModifier add = new AttributeModifier(UUID.randomUUID(), "same", 2, 0);
+        AttributeModifier relative = new AttributeModifier(UUID.randomUUID(), "same", 0.5, 1);
+        AttributeModifier multiply = new AttributeModifier(UUID.randomUUID(), "same", 1, 2);
+
+        assertEquals(10, value.getValue(), 0);
+        value.b(add);
+        base.b(relative);
+        value.b(multiply);
+        assertTrue(additions.contains(add));
+        assertSame(add, value.a(add.a()));
+        assertEquals(36, value.getValue(), 0);
+        assertEquals(2, value.c().size());
+        value.c().clear();
+        assertEquals(2, value.c().size());
+        value.c(new AttributeModifier(add.a(), "different", 9, 2));
+        assertTrue(additions.isEmpty());
+        assertNull(value.a(add.a()));
+        assertEquals(30, value.getValue(), 0);
+        base.c(relative);
+        assertEquals(20, value.getValue(), 0);
+    }
