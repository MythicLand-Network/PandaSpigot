new file mode 100644
index 000000000..5c3b1f42c
--- /dev/null
+++ b/src/main/java/net/minecraft/server/AnimationBroadcast.java
@@ -0,0 +1,53 @@
+package net.minecraft.server;
+
+import io.netty.channel.Channel;
+import io.netty.channel.EventLoop;
+import io.netty.channel.SingleThreadEventLoop;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+import java.util.concurrent.RejectedExecutionException;
+
+final class AnimationBroadcast {
+    private static final ThreadLocal<AnimationBroadcast> LOCAL = ThreadLocal.withInitial(AnimationBroadcast::new);
+    private static final Runnable WAKE = () -> {};
+
+    private final Set<EventLoop> transports = Collections.newSetFromMap(new IdentityHashMap<>());
+    private PacketPlayOutAnimation packet;
+
+    static AnimationBroadcast begin(PacketPlayOutAnimation packet) {
+        AnimationBroadcast batch = LOCAL.get();
+        if (batch.packet != null) return null;
+        batch.packet = packet;
+        return batch;
+    }
+
+    void finish() {
+        this.packet = null;
+        RejectedExecutionException failure = null;
+        try {
+            for (EventLoop loop : this.transports) {
+                try {
+                    loop.execute(WAKE);
+                } catch (RejectedExecutionException rejected) {
+                    if (!loop.isShuttingDown()) failure = rejected;
+                }
+            }
+        } finally {
+            this.transports.clear();
+        }
+        if (failure != null) throw failure;
+    }
+
+    static boolean defer(Packet packet, Channel channel, EventLoop dispatch, Thread thread) {
+        AnimationBroadcast batch = LOCAL.get();
+        if (batch.packet != packet || thread == null) return false;
+        EventLoop transport = channel.pipeline().channel().eventLoop();
+        if (!(transport instanceof SingleThreadEventLoop) || !transport.inEventLoop(thread)) return false;
+        if (dispatch != transport && !dispatch.inEventLoop(thread)) return false;
+        // Submit the original write through the dispatch loop so packet listeners run normally.
+        // Clients registered on the same transport need just one wakeup at the end of this broadcast.
+        batch.transports.add(transport);
+        return true;
+    }
+}
