diff --git a/src/test/java/net/minecraft/server/NetworkFlushTest.java b/src/test/java/net/minecraft/server/NetworkFlushTest.java
index ffd3f3382..888745f50 100644
--- a/src/test/java/net/minecraft/server/NetworkFlushTest.java
+++ b/src/test/java/net/minecraft/server/NetworkFlushTest.java
@@ -163,8 +163,86 @@ public class NetworkFlushTest extends AbstractTestingBase {
         }
     }
 
+    @Test
+    public void queuedAnimationsShareAFlushAndUrgentWritesStillFlushImmediately() throws Exception {
+        DefaultEventLoop loop = new DefaultEventLoop();
+        LocalChannel channel = new LocalChannel();
+        List<Object> messages = new ArrayList<>();
+        CountingFlush counter = new CountingFlush() {
+            @Override
+            public void write(ChannelHandlerContext ctx, Object message, ChannelPromise promise) {
+                messages.add(message);
+                promise.setSuccess();
+            }
+        };
+        NetworkFlushHandler handler = new NetworkFlushHandler();
+        Packet first = new PacketPlayOutAnimation();
+        Packet second = new PacketPlayOutAnimation();
+        Packet urgent = new PacketPlayOutKeepAlive(7);
+        try {
+            loop.register(channel).sync();
+            channel.pipeline().addLast(counter, handler);
+            loop.submit(() -> {
+                handler.writeAnimation(channel, first);
+                handler.writeAnimation(channel, second);
+                assertEquals(0, counter.flushes);
+            }).sync();
+            loop.submit(() -> {
+                assertEquals(1, counter.flushes);
+                handler.writeAnimation(channel, first);
+                channel.writeAndFlush(urgent);
+                assertEquals(2, counter.flushes);
+            }).sync();
+            loop.submit(() -> {
+                assertEquals(2, counter.flushes);
+                assertEquals(Arrays.asList(first, second, first, urgent), messages);
+            }).sync();
+        } finally {
+            channel.close().sync();
+            loop.shutdownGracefully(0, 0, java.util.concurrent.TimeUnit.MILLISECONDS).sync();
+        }
+    }
+
+    @Test
+    public void animationViewersOnTheSameTransportShareOneWakeup() throws Exception {
+        RecordingEventLoop loop = new RecordingEventLoop();
+        LocalChannel first = new LocalChannel();
+        LocalChannel second = new LocalChannel();
+        try {
+            loop.register(first).sync();
+            loop.register(second).sync();
+            Thread transport = loop.submit(Thread::currentThread).sync().getNow();
+            PacketPlayOutAnimation animation = new PacketPlayOutAnimation();
+            AnimationBroadcast batch = AnimationBroadcast.begin(animation);
+            try {
+                PacketPlayOutAnimation nested = new PacketPlayOutAnimation();
+                assertNull(AnimationBroadcast.begin(nested));
+                assertFalse(AnimationBroadcast.defer(nested, first, loop, transport));
+                assertFalse(AnimationBroadcast.defer(animation, first, loop, Thread.currentThread()));
+                assertTrue(AnimationBroadcast.defer(animation, first, loop, transport));
+                assertTrue(AnimationBroadcast.defer(animation, second, loop, transport));
+            } finally {
+                int previous = loop.submissions.get();
+                batch.finish();
+                assertEquals(previous + 1, loop.submissions.get());
+            }
+            assertFalse(AnimationBroadcast.defer(animation, first, loop, transport));
+        } finally {
+            first.close().sync();
+            second.close().sync();
+            loop.shutdownGracefully(0, 0, java.util.concurrent.TimeUnit.MILLISECONDS).sync();
+        }
+    }
+
     private static class RecordingEventLoop extends DefaultEventLoop {
         private final AtomicInteger lazyWrites = new AtomicInteger();
+        private final AtomicInteger submissions = new AtomicInteger();
+
+        @Override
+        public void execute(Runnable task) {
+            submissions.incrementAndGet();
+            super.execute(task);
+        }
 
         @Override
         public void lazyExecute(Runnable task) {
