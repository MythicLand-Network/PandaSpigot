+    void resetPlayerPositionPrediction() {
+        if (this.playerPrediction != null) {
+            this.playerPrediction.reset();
+        }
+    }
+
+    private static boolean fitsRelativeMove(int x, int y, int z) {
+        return x >= -128 && x < 128 && y >= -128 && y < 128 && z >= -128 && z < 128;
+    }
+
+    private boolean canSendPredictedPosition(int x, int z) {
+        final World world = this.tracker.world;
+        final AxisAlignedBB current = this.tracker.getBoundingBox();
+        final double dx = x / 32.0D - this.tracker.locX;
+        final double dz = z / 32.0D - this.tracker.locZ;
+        final AxisAlignedBB swept = current.a(dx, 0.0D, dz);
+        final WorldBorder border = world.getWorldBorder();
+        if (swept.a < border.b() || swept.d > border.d() || swept.c < border.c() || swept.f > border.e()) {
+            return false;
+        }
+
+        // Use block-only collision queries over loaded chunks. The movement query can mutate entity state.
+        final BlockPosition min = new BlockPosition(swept.a, swept.b - 1.0D, swept.c);
+        final BlockPosition max = new BlockPosition(swept.d, swept.e, swept.f);
+        return world.areChunksLoadedBetween(min, max)
+                && world.a(swept).isEmpty()
+                && !world.a(current.c(dx, -0.0625D, dz)).isEmpty();
+    }
+
+    private static final class PlayerPositionPrediction {
+        private static final double MIN_SPEED_SQUARED = 0.27D * 0.27D;
+        private static final double MAX_SPEED_SQUARED = 0.90D * 0.90D;
+        private static final double MAX_LEAD = 0.50D;
+        private static final double MIN_DIRECTION_ALIGNMENT_SQUARED = 0.90D;
+
+        private double sampleX, sampleY, sampleZ;
+        private double previousDX, previousDZ;
+        private double leadX, leadZ;
+        private int stationaryTicks;
+        private boolean sampled;
+
+        void sample(EntityPlayer player) {
+            this.leadX = this.leadZ = 0.0D;
+            if (!player.onGround || player.dead || player.vehicle != null || player.abilities.isFlying || player.isSpectator()
+                    || player.isSleeping() || player.velocityChanged || player.ai) {
+                this.reset();
+                return;
+            }
+
+            final double dx = player.locX - this.sampleX;
+            final double dz = player.locZ - this.sampleZ;
+            final double speedSquared = dx * dx + dz * dz;
+            if (this.sampled && player.locY == this.sampleY
+                    && speedSquared >= MIN_SPEED_SQUARED && speedSquared <= MAX_SPEED_SQUARED) {
+                final double previousSpeedSquared = this.previousDX * this.previousDX + this.previousDZ * this.previousDZ;
+                final double alignment = dx * this.previousDX + dz * this.previousDZ;
+                if (previousSpeedSquared >= MIN_SPEED_SQUARED && alignment > 0.0D
+                        && alignment * alignment >= MIN_DIRECTION_ALIGNMENT_SQUARED * speedSquared * previousSpeedSquared) {
+                    final double scale = Math.min(1.0D, MAX_LEAD / Math.sqrt(speedSquared));
+                    this.leadX = dx * scale;
+                    this.leadZ = dz * scale;
+                }
+                this.previousDX = dx;
+                this.previousDZ = dz;
+                this.stationaryTicks = 0;
+            } else if (!this.sampled || speedSquared != 0.0D || player.locY != this.sampleY || ++this.stationaryTicks >= 2) {
+                this.previousDX = this.previousDZ = 0.0D;
+                this.stationaryTicks = 0;
+            }
+            this.sampleX = player.locX;
+            this.sampleY = player.locY;
+            this.sampleZ = player.locZ;
+            this.sampled = true;
+        }
+
+        boolean hasLead() {
+            return this.leadX != 0.0D || this.leadZ != 0.0D;
+        }
+
+        void reset() {
+            this.sampled = false;
+            this.previousDX = this.previousDZ = 0.0D;
+            this.leadX = this.leadZ = 0.0D;
+            this.stationaryTicks = 0;
+        }
+    }
+
     private void b() {
         DataWatcher datawatcher = this.tracker.getDataWatcher();
 
